# Required to accept booking and contact inquiries on hosted/serverless deployments.
# Point to an HTTPS endpoint you own that durably stores and/or notifies about requests.
OJUEWA_SUBMISSION_WEBHOOK_URL=https://your-server.example.com/api/ojuewa/submissions
# Strong secret shared with the receiving endpoint.
OJUEWA_SUBMISSION_WEBHOOK_TOKEN=replace-with-long-random-token

# Local development ONLY (defaults to ./data/ojuewa.sqlite)
# DATABASE_PATH=./data/ojuewa.sqlite
